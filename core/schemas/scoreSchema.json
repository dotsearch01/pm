{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScoreSchema",
  "type": "object",
  "required": [
    "overall_score",
    "component_scores",
    "scoring_logic",
    "critical_issues_count",
    "high_impact_count"
  ],
  "properties": {
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "component_scores": {
      "type": "object",
      "required": [
        "technical_accessibility",
        "content_retrieval",
        "entity_coverage",
        "experience_trust",
        "citation_readiness",
        "external_authority",
        "ai_visibility"
      ],
      "properties": {
        "technical_accessibility": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "content_retrieval": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "entity_coverage": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "experience_trust": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "citation_readiness": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "external_authority": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } },
        "ai_visibility": { "type": "object", "properties": { "score": { "type": "number" }, "reason": { "type": "string" } } }
      }
    },
    "scoring_logic": { "type": "string" },
    "critical_issues_count": { "type": "integer" },
    "high_impact_count": { "type": "integer" }
  }
}
