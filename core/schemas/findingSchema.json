{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FindingSchema",
  "type": "object",
  "required": [
    "id",
    "category",
    "severity",
    "title",
    "status",
    "evidence",
    "impact",
    "recommendation",
    "implementation",
    "affected_pages",
    "source",
    "confidence",
    "requires_verification"
  ],
  "properties": {
    "id": { "type": "string" },
    "category": { "type": "string", "enum": ["technical", "content", "entity", "citation", "authority", "visibility", "ui", "scoring"] },
    "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "INFO"] },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "warning", "fail", "not_applicable", "unknown"] },
    "evidence": { "type": "string" },
    "impact": { "type": "string" },
    "recommendation": { "type": "string" },
    "implementation": { "type": "string" },
    "affected_pages": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_verification": { "type": "boolean" }
  }
}
